# ═══════════════════════════════════════════════════════════════════
# Listify — Server Environment Variables
# Copy this file to .env and fill in real values.
# When using Docker, use the ROOT .env file instead (../  .env).
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
# Web dashboard / CORS only — do NOT use for email buttons (app uses deep links below)
CLIENT_URL=http://localhost:80
# Mobile app deep links used in transactional emails (password reset, welcome, etc.)
APP_DEEP_LINK_SCHEME=listifyapp
# Optional overrides:
# APP_SIGN_IN_URL=listifyapp://sign-in
# APP_HOME_URL=listifyapp://

# ── MongoDB ───────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=your-general-jwt-secret-min-64-chars
JWT_ACCESS_SECRET=your-access-secret-min-64-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-64-chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ── Upstash Redis ─────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Elasticsearch / OpenSearch ────────────────────────────────────
# Option A: AWS OpenSearch with fine-grained access control (username/password)
# ELASTICSEARCH_URL=https://search-your-domain-id.ap-south-1.es.amazonaws.com
# ELASTIC_USERNAME=your-master-username
# ELASTIC_PASSWORD=your-master-password
# AWS_OPENSEARCH_REGION=ap-south-1
# AWS_OPENSEARCH_IAM_AUTH=false

# Option B: AWS OpenSearch with IAM Sig v4
# ELASTICSEARCH_URL=https://search-your-domain-id.ap-south-1.es.amazonaws.com
# AWS_OPENSEARCH_IAM_AUTH=true
# AWS_OPENSEARCH_REGION=ap-south-1

# Option C: Elastic Cloud API key
# ELASTICSEARCH_URL=https://your-deployment.es.cloud.es.io:9243
# ELASTICSEARCH_API_KEY=your-base64-api-key

# Local Docker Elasticsearch fallback (if using bundled elasticsearch service)
# ELASTICSEARCH_URL=http://elasticsearch:9200
# ELASTIC_USERNAME=elastic
# ELASTIC_PASSWORD=your-strong-elastic-password

# ── Firebase Cloud Messaging (push notifications) ─────────────────
# Must match the app's google-services.json project: listifys (582870381419)
#
# Option A (recommended for local dev): place service account JSON at:
#   server/config/firebase-service-account.json
#
# Option B: point to a custom path (a .json file — NOT the JSON content itself)
# FIREBASE_SERVICE_ACCOUNT_PATH=config/firebase-service-account.json
#
# Option C: paste the full service account JSON as one line (Render / Railway)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"listifys",...}
#
# Option D: individual env vars
# FIREBASE_PROJECT_ID=listifys
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@listifys.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── AWS S3 ────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=listify-uploads
AWS_S3_BUCKET_URL=https://listify-uploads.s3.us-east-1.amazonaws.com
# Optional: CloudFront distribution URL for CDN
# AWS_CLOUDFRONT_URL=https://d1234567.cloudfront.net
# Set true only when the S3 bucket is private and images must stream through the API.
AWS_S3_FORCE_PROXY=false

# ── Email (SMTP) ─────────────────────────────────────────────────
# Gmail App Password (works locally; many cloud hosts block smtp.gmail.com):
#   EMAIL_USER=your-email@gmail.com
#   EMAIL_PASSWORD=your-16-char-app-password
#
# Transactional relay (recommended for Render/Railway/AWS — outbound SMTP is often blocked):
#   Brevo:    SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  EMAIL_USER=your-brevo-login  EMAIL_PASSWORD=your-brevo-smtp-key
#   Brevo API (recommended when SMTP ports/IPs are blocked — uses HTTPS, not SMTP):
#   BREVO_API_KEY=xkeysib-your-api-key
#   SendGrid: SMTP_HOST=smtp.sendgrid.net    SMTP_PORT=587  EMAIL_USER=apikey            EMAIL_PASSWORD=SG.your-api-key
#   Resend:   SMTP_HOST=smtp.resend.com      SMTP_PORT=587  EMAIL_USER=resend            EMAIL_PASSWORD=re_your-api-key
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# EMAIL_FROM="Listify" <your-email@gmail.com>
# Dev only — return OTP in API responses when SMTP is blocked (never enable in production):
# EXPOSE_OTP_IN_RESPONSE=true

# ── Google OAuth ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# ── Engagement push notifications (FOMO / weekly digest) ─────────
ENGAGEMENT_NOTIFICATIONS_ENABLED=true
ENGAGEMENT_TIMEZONE=Asia/Kolkata
ENGAGEMENT_MAX_PER_WEEK=4
ENGAGEMENT_MIN_HOURS_BETWEEN=20
ENGAGEMENT_RE_ENGAGE_DAYS=3

# ── Twilio (Phone OTP — SMS + WhatsApp) ───────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# For WhatsApp OTP (Twilio Sandbox: +14155238886, or your approved sender)
TWILIO_WHATSAPP_NUMBER=+14155238886
# Fallback if not using Messaging Service:
# TWILIO_PHONE_NUMBER=+1234567890

# ── Chat Encryption (AES-256-GCM) ────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Do NOT lose this key — all stored messages become unreadable without it!
CHAT_ENCRYPTION_KEY=your-64-char-hex-key-here

# ── Admin Seed ────────────────────────────────────────────────────
# Optional fallback shared password (used only when a per-admin password is omitted)
ADMIN_SEED_PASSWORD=OptionalSharedPassword
# Update passwords for existing users matched by email during seeding
ADMIN_SEED_UPDATE_EXISTING_PASSWORDS=true
# Admin accounts (Name:email:password, comma-separated)
ADMIN_SEED_ACCOUNTS=Admin User:admin@example.com:ChangeMe@2026,Another Admin:admin2@example.com:ChangeMe@2026

# ── AWS CloudWatch Logging ────────────────────────────────────────
# Uses the same AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION above.
# IAM user must have these permissions for CloudWatch Logs:
#   logs:CreateLogGroup, logs:CreateLogStream, logs:PutLogEvents,
#   logs:PutRetentionPolicy, logs:DescribeLogStreams
#
# Optional overrides (defaults shown):
# SERVICE_NAME=listify-api
# LOG_ENV=production                     # auto-detected from NODE_ENV
# LOG_RETENTION_DAYS=90                  # CloudWatch retention in days
# INSTANCE_ID=hostname-pid               # auto-detected; override for ECS/Fargate



# rabbitMQ
RABBITMQ_URL=amqps://user:password@your-rabbitmq-host.example.com/vhost

# ── Vertex AI (Gemini) ────────────────────────────────────────────
VERTEX_AI_PROJECT_ID=your-project-id
VERTEX_AI_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=config/gcp-vertex-service-account.json

# ── Google Vision (Image Moderation) ─────────────────────────────
GOOGLE_VISION_CREDENTIALS_PATH=config/gcp-vision-service-account.json

# ── Razorpay (TEST mode keys for development) ─────────────────────
# Secret keys MUST stay on the server only — never in Expo / EXPO_PUBLIC_
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── PayU (TEST mode — server only, never in Expo) ─────────────────
# Test checkout: https://test.payu.in/_payment
# Production:    https://secure.payu.in/_payment
PAYU_MERCHANT_KEY=your_payu_test_key
PAYU_MERCHANT_SALT=your_payu_test_salt
PAYU_ENV=test
# PayU success/failure callbacks — must be public HTTPS (Render backend URL)
PAYU_CALLBACK_BASE_URL=https://listifys-new-app.onrender.com
# Optional legacy alias
# PUBLIC_API_BASE_URL=https://listifys-new-app.onrender.com
# Optional: webhook signing secret if PayU provides one in Developer → Webhooks
# PAYU_WEBHOOK_SECRET=
