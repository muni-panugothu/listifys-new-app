# Monorepo root — EAS uploads from git root when building from app/
# Mobile build only needs app/; exclude everything else below.

# Backend (not part of mobile build)
server

# Docs and scratch folders
docs
.tmp-screens

# Native / deps under app (EAS runs fresh prebuild + npm install)
app/android
app/ios
app/node_modules
app/.expo
app/.expo-export-test
app/dist

# Gradle / CMake caches (often locked on Windows during local builds)
**/.gradle
**/.cxx
**/android/build
**/android/app/build

# Env and secrets
**/.env
**/.env.*

# Source control
.git
