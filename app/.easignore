**/.gradle/**
**/.cxx

# Monorepo folders outside app/ (included when archive is built from git root)
../server
../docs
../.tmp-screens

# Temporary and log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store

# Environment files
.env
.env.*

# Local signing keys
*.keystore
*.jks
*.map

# Generated web output
**/build
**/.next

# Source control metadata
.git
../.git
